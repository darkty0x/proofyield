# === Mode ===
# live = real Attestcoin proofs on CC3 + wallet vault I/O (beta)
# demo = local in-memory vault (unit tests / offline only)
PROOFYIELD_MODE=live

# === RPCs ===
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
ATTESTCOIN_PROVER_URL=https://prover.cc3-testnet.creditcoin.network

# === Keys (never commit; never film) ===
DEPLOYER_PRIVATE_KEY=
HARVESTER_PRIVATE_KEY=

# === Deployed addresses (fill after deploy, or use deployments/testnet.json) ===
SEPOLIA_RWA_SOURCE=
CREDITCOIN_VAULT=
CREDITCOIN_ASSET=
SEPOLIA_CHAIN_KEY=1

# === Agent ===
PORT=8787
POLL_INTERVAL_MS=15000
MAX_COUPON_BPS=500
MIN_RISK_SCORE=40
OPENAI_API_KEY=
DEMO_SEED_TVL=1250000
DEMO_TOKEN_SUPPLY=10000000
PROMISED_APY_BPS=842
FAUCET_AMOUNT=10000
FAUCET_COOLDOWN_MS=60000

# === Web ===
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_SEPOLIA_EXPLORER=https://sepolia.etherscan.io
NEXT_PUBLIC_CTC_EXPLORER=https://creditcoin-testnet.blockscout.com
